# grok-discord-bridge: the ONLY environment values. Everything else is changed with /bridge slash commands in Discord.
# Copy to .env, fill in, then: chmod 600 .env     (never commit .env; no quotes needed around values)

# Your OWN bot's token: Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# From your Grok Bot routine's webhook trigger (routine panel): the URL and the key.
WEBHOOK_URL=
WEBHOOK_KEY=

# Your own Discord user id (Developer Mode on > right-click yourself > Copy User ID). Required.
# Only this account can use /bridge commands and give the agent tasks.
OWNER_ID=

# --- optional ---
# Where settings.json / state files live. Docker image default: /app/data. Direct node default: ./data
# DATA_DIR=./data
# Seed settings.json on first start from a base64 of an exported settings file (see docs/DIGITALOCEAN.md).
# SETTINGS_B64=
